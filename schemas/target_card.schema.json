{
  "$defs": {
    "ExperimentOutcome": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.1.0",
          "default": "2.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "positive",
            "negative",
            "contradictory"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "conclusion": {
          "title": "Conclusion",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "observation",
        "conclusion",
        "next_action"
      ],
      "title": "ExperimentOutcome",
      "type": "object"
    },
    "ExperimentPlan": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.1.0",
          "default": "2.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "model_system": {
          "title": "Model System",
          "type": "string"
        },
        "intervention": {
          "title": "Intervention",
          "type": "string"
        },
        "direction": {
          "enum": [
            "activate",
            "inhibit",
            "knockout",
            "overexpress",
            "compare"
          ],
          "title": "Direction",
          "type": "string"
        },
        "controls": {
          "items": {
            "type": "string"
          },
          "title": "Controls",
          "type": "array"
        },
        "primary_endpoints": {
          "items": {
            "type": "string"
          },
          "title": "Primary Endpoints",
          "type": "array"
        },
        "secondary_endpoints": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Endpoints",
          "type": "array"
        },
        "replication_and_power": {
          "title": "Replication And Power",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/ExperimentOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "highest_information_next_experiment": {
          "title": "Highest Information Next Experiment",
          "type": "string"
        },
        "stop_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "hypothesis",
        "model_system",
        "intervention",
        "direction",
        "controls",
        "primary_endpoints",
        "secondary_endpoints",
        "replication_and_power",
        "outcomes",
        "highest_information_next_experiment",
        "stop_conditions"
      ],
      "title": "ExperimentPlan",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.1.0",
          "default": "2.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "human_genetics": {
          "maximum": 25,
          "minimum": 0,
          "title": "Human Genetics",
          "type": "number"
        },
        "disease_omics": {
          "maximum": 20,
          "minimum": 0,
          "title": "Disease Omics",
          "type": "number"
        },
        "perturbation": {
          "maximum": 20,
          "minimum": 0,
          "title": "Perturbation",
          "type": "number"
        },
        "mechanism": {
          "maximum": 15,
          "minimum": 0,
          "title": "Mechanism",
          "type": "number"
        },
        "druggability": {
          "maximum": 10,
          "minimum": 0,
          "title": "Druggability",
          "type": "number"
        },
        "safety_translation": {
          "maximum": 10,
          "minimum": 0,
          "title": "Safety Translation",
          "type": "number"
        },
        "total": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "human_genetics",
        "disease_omics",
        "perturbation",
        "mechanism",
        "druggability",
        "safety_translation",
        "total"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.1.0",
      "default": "2.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "target_card_id": {
      "title": "Target Card Id",
      "type": "string"
    },
    "gene_symbol": {
      "title": "Gene Symbol",
      "type": "string"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "decision": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "NO_GO",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "Decision",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/ScoreBreakdown"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "supporting_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "opposing_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Opposing Evidence Ids",
      "type": "array"
    },
    "safety_blockers": {
      "items": {
        "type": "string"
      },
      "title": "Safety Blockers",
      "type": "array"
    },
    "evidence_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Gaps",
      "type": "array"
    },
    "matched_drugs": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Matched Drugs",
      "type": "array"
    },
    "experiment_plan": {
      "$ref": "#/$defs/ExperimentPlan"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "gene_symbol",
    "rank",
    "decision",
    "scores",
    "evidence_ids",
    "experiment_plan"
  ],
  "title": "TargetCard",
  "type": "object"
}
