{
  "$defs": {
    "ClaimClass": {
      "enum": [
        "FACT",
        "OBSERVED",
        "PREDICTED",
        "INFERRED"
      ],
      "title": "ClaimClass",
      "type": "string"
    },
    "EvidenceContext": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.1.0",
          "default": "2.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "organism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "tissue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tissue"
        },
        "cell_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Type"
        },
        "disease": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disease"
        },
        "disease_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disease Stage"
        },
        "assay": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay"
        },
        "perturbation_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perturbation Type"
        }
      },
      "title": "EvidenceContext",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.1.0",
          "default": "2.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        }
      },
      "required": [
        "uri",
        "source_id"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "Stance": {
      "enum": [
        "supports",
        "refutes",
        "mixed",
        "uncertain"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.1.0",
      "default": "2.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "tool_run_id": {
      "minLength": 1,
      "title": "Tool Run Id",
      "type": "string"
    },
    "gene_symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gene Symbol"
    },
    "claim_class": {
      "$ref": "#/$defs/ClaimClass"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceLocator"
    },
    "source_span": {
      "minLength": 1,
      "title": "Source Span",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/EvidenceContext"
    },
    "stance": {
      "$ref": "#/$defs/Stance",
      "default": "uncertain"
    },
    "effect_direction": {
      "default": "unclear",
      "enum": [
        "increase",
        "decrease",
        "mixed",
        "unclear"
      ],
      "title": "Effect Direction",
      "type": "string"
    },
    "effect": {
      "additionalProperties": true,
      "title": "Effect",
      "type": "object"
    },
    "uncertainty": {
      "minLength": 1,
      "title": "Uncertainty",
      "type": "string"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "context_match_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Context Match Score",
      "type": "number"
    }
  },
  "required": [
    "tool_run_id",
    "claim_class",
    "statement",
    "source",
    "source_span",
    "context",
    "uncertainty",
    "context_match_score"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
