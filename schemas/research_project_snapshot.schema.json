{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "work_item_id": {
          "title": "Work Item Id",
          "type": "string"
        },
        "logical_name": {
          "minLength": 1,
          "title": "Logical Name",
          "type": "string"
        },
        "uri": {
          "pattern": "^project://",
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "work_item_id",
        "logical_name",
        "uri",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "AssessmentDimension": {
      "enum": [
        "integrity",
        "provenance",
        "entailment",
        "methodology",
        "applicability",
        "reproducibility",
        "schema_alignment"
      ],
      "title": "AssessmentDimension",
      "type": "string"
    },
    "AssessmentLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "human"
      ],
      "title": "AssessmentLevel",
      "type": "string"
    },
    "AssessmentRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "assessment_id": {
          "title": "Assessment Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "target_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Digest"
        },
        "dimension": {
          "$ref": "#/$defs/AssessmentDimension"
        },
        "level": {
          "$ref": "#/$defs/AssessmentLevel"
        },
        "result": {
          "$ref": "#/$defs/AssessmentResult"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "target_id",
        "dimension",
        "level",
        "result",
        "actor",
        "method",
        "rationale"
      ],
      "title": "AssessmentRecord",
      "type": "object"
    },
    "AssessmentResult": {
      "enum": [
        "pass",
        "fail",
        "uncertain",
        "not_assessed"
      ],
      "title": "AssessmentResult",
      "type": "string"
    },
    "AutonomyMode": {
      "enum": [
        "autonomous",
        "checkpointed",
        "supervised"
      ],
      "title": "AutonomyMode",
      "type": "string"
    },
    "DataContract": {
      "additionalProperties": false,
      "description": "Small deterministic boundary contract; no runtime JSON-schema dependency.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "field_types": {
          "additionalProperties": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ],
            "type": "string"
          },
          "title": "Field Types",
          "type": "object"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "DataContract",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "accept",
        "reject",
        "replan",
        "request_evidence",
        "override",
        "release"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "DecisionEvent": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "evidence_snapshot_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Snapshot Digest"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "action",
        "target_ids",
        "rationale",
        "actor"
      ],
      "title": "DecisionEvent",
      "type": "object"
    },
    "FailureClass": {
      "enum": [
        "transient",
        "permanent",
        "missing_input",
        "scientific_gap",
        "integrity_failure",
        "unsupported",
        "internal"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "ProjectState": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProjectStatus",
          "default": "draft"
        },
        "current_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Item Id"
        },
        "completed_items": {
          "items": {
            "type": "string"
          },
          "title": "Completed Items",
          "type": "array"
        },
        "failed_items": {
          "items": {
            "type": "string"
          },
          "title": "Failed Items",
          "type": "array"
        },
        "attempts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Attempts",
          "type": "object"
        },
        "checkpoint_kind": {
          "anyOf": [
            {
              "enum": [
                "plan",
                "work_item",
                "repair",
                "release"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Kind"
        },
        "checkpoint_target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Target Id"
        },
        "checkpoint_snapshot_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Snapshot Digest"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectState",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "draft",
        "planned",
        "running",
        "waiting_review",
        "completed",
        "completed_with_gaps",
        "needs_input",
        "failed",
        "cancelled"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RepairAction": {
      "enum": [
        "rerun_subgraph_same_inputs",
        "request_input",
        "retain_gap",
        "stop"
      ],
      "title": "RepairAction",
      "type": "string"
    },
    "RepairAuthorization": {
      "enum": [
        "automatic",
        "checkpoint_required",
        "human_input_required",
        "prohibited"
      ],
      "title": "RepairAuthorization",
      "type": "string"
    },
    "RepairRequest": {
      "additionalProperties": false,
      "description": "Immutable assessment-triggered request evaluated by deterministic policy.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "repair_request_id": {
          "pattern": "^repair-[a-f0-9]{24}$",
          "title": "Repair Request Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "base_plan_id": {
          "title": "Base Plan Id",
          "type": "string"
        },
        "target_work_item_id": {
          "title": "Target Work Item Id",
          "type": "string"
        },
        "trigger_assessment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trigger Assessment Ids",
          "type": "array"
        },
        "trigger_result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trigger Result Digest",
          "type": "string"
        },
        "trigger_snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trigger Snapshot Digest",
          "type": "string"
        },
        "failure_class": {
          "$ref": "#/$defs/FailureClass"
        },
        "action": {
          "$ref": "#/$defs/RepairAction"
        },
        "risk": {
          "$ref": "#/$defs/RepairRisk"
        },
        "authorization": {
          "$ref": "#/$defs/RepairAuthorization"
        },
        "affected_work_item_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Work Item Ids",
          "type": "array"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "policy_rule_id": {
          "title": "Policy Rule Id",
          "type": "string"
        },
        "policy_version": {
          "default": "1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "repair_request_id",
        "project_id",
        "base_plan_id",
        "target_work_item_id",
        "trigger_assessment_ids",
        "trigger_result_digest",
        "trigger_snapshot_digest",
        "failure_class",
        "action",
        "risk",
        "authorization",
        "affected_work_item_ids",
        "input_digest",
        "policy_rule_id",
        "success_criteria",
        "rationale"
      ],
      "title": "RepairRequest",
      "type": "object"
    },
    "RepairResolution": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "resolution_id": {
          "pattern": "^resolution-[a-f0-9]{24}$",
          "title": "Resolution Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "repair_request_id": {
          "pattern": "^repair-[a-f0-9]{24}$",
          "title": "Repair Request Id",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^revision-[a-f0-9]{24}$",
          "title": "Revision Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RepairResolutionStatus"
        },
        "before_snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Snapshot Digest",
          "type": "string"
        },
        "after_snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Snapshot Digest",
          "type": "string"
        },
        "verification_assessment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Verification Assessment Ids",
          "type": "array"
        },
        "active_work_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Active Work Item Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "resolution_id",
        "project_id",
        "repair_request_id",
        "revision_id",
        "status",
        "before_snapshot_digest",
        "after_snapshot_digest",
        "rationale"
      ],
      "title": "RepairResolution",
      "type": "object"
    },
    "RepairResolutionStatus": {
      "enum": [
        "resolved",
        "mitigated",
        "unresolved",
        "exhausted"
      ],
      "title": "RepairResolutionStatus",
      "type": "string"
    },
    "RepairRisk": {
      "enum": [
        "R0_derivation_only",
        "R1_same_scope_read_only",
        "R2_scientific_method_change",
        "R3_scope_or_truth_change"
      ],
      "title": "RepairRisk",
      "type": "string"
    },
    "ResearchGoal": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "question": {
          "minLength": 3,
          "title": "Question",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "deliverables": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Deliverables",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "question",
        "success_criteria",
        "deliverables"
      ],
      "title": "ResearchGoal",
      "type": "object"
    },
    "ResearchPlan": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/WorkItemSpec"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "planner_backend": {
          "title": "Planner Backend",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "items",
        "planner_backend",
        "rationale"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "ResearchPlanRevision": {
      "additionalProperties": false,
      "description": "Append-only execution overlay; never a free-form replacement plan.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^revision-[a-f0-9]{24}$",
          "title": "Revision Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "base_plan_id": {
          "title": "Base Plan Id",
          "type": "string"
        },
        "parent_revision_id": {
          "anyOf": [
            {
              "pattern": "^revision-[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Revision Id"
        },
        "revision_number": {
          "maximum": 2,
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "repair_request_id": {
          "pattern": "^repair-[a-f0-9]{24}$",
          "title": "Repair Request Id",
          "type": "string"
        },
        "operation": {
          "const": "rerun_subgraph_same_inputs",
          "default": "rerun_subgraph_same_inputs",
          "title": "Operation",
          "type": "string"
        },
        "added_items": {
          "items": {
            "$ref": "#/$defs/WorkItemSpec"
          },
          "minItems": 1,
          "title": "Added Items",
          "type": "array"
        },
        "superseded_item_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Superseded Item Ids",
          "type": "array"
        },
        "superseded_assessment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Superseded Assessment Ids",
          "type": "array"
        },
        "trigger_snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trigger Snapshot Digest",
          "type": "string"
        },
        "revision_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision Digest",
          "type": "string"
        },
        "approval_required": {
          "title": "Approval Required",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "project_id",
        "base_plan_id",
        "revision_number",
        "repair_request_id",
        "added_items",
        "superseded_item_ids",
        "trigger_snapshot_digest",
        "revision_digest",
        "approval_required"
      ],
      "title": "ResearchPlanRevision",
      "type": "object"
    },
    "ResearchProjectSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "domain": {
          "default": "disease_target_discovery",
          "enum": [
            "disease_target_discovery",
            "life_science"
          ],
          "title": "Domain",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/ResearchGoal"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "autonomy_mode": {
          "$ref": "#/$defs/AutonomyMode",
          "default": "checkpointed"
        },
        "max_work_items": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Work Items",
          "type": "integer"
        },
        "max_replans": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "title",
        "goal"
      ],
      "title": "ResearchProjectSpec",
      "type": "object"
    },
    "WorkItemResult": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": true,
