{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "work_item_id": {
          "title": "Work Item Id",
          "type": "string"
        },
        "logical_name": {
          "minLength": 1,
          "title": "Logical Name",
          "type": "string"
        },
        "uri": {
          "pattern": "^project://",
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "work_item_id",
        "logical_name",
        "uri",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "AssessmentDimension": {
      "enum": [
        "integrity",
        "provenance",
        "entailment",
        "methodology",
        "applicability",
        "reproducibility",
        "schema_alignment"
      ],
      "title": "AssessmentDimension",
      "type": "string"
    },
    "AssessmentLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "human"
      ],
      "title": "AssessmentLevel",
      "type": "string"
    },
    "AssessmentRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "assessment_id": {
          "title": "Assessment Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "target_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Digest"
        },
        "dimension": {
          "$ref": "#/$defs/AssessmentDimension"
        },
        "level": {
          "$ref": "#/$defs/AssessmentLevel"
        },
        "result": {
          "$ref": "#/$defs/AssessmentResult"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "target_id",
        "dimension",
        "level",
        "result",
        "actor",
        "method",
        "rationale"
      ],
      "title": "AssessmentRecord",
      "type": "object"
    },
    "AssessmentResult": {
      "enum": [
        "pass",
        "fail",
        "uncertain",
        "not_assessed"
      ],
      "title": "AssessmentResult",
      "type": "string"
    },
    "AutonomyMode": {
      "enum": [
        "autonomous",
        "checkpointed",
        "supervised"
      ],
      "title": "AutonomyMode",
      "type": "string"
    },
    "DataContract": {
      "additionalProperties": false,
      "description": "Small deterministic boundary contract; no runtime JSON-schema dependency.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "field_types": {
          "additionalProperties": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ],
            "type": "string"
          },
          "title": "Field Types",
          "type": "object"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "DataContract",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "accept",
        "reject",
        "replan",
        "request_evidence",
        "override",
        "release"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "DecisionEvent": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "evidence_snapshot_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Snapshot Digest"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "action",
        "target_ids",
        "rationale",
        "actor"
      ],
      "title": "DecisionEvent",
      "type": "object"
    },
    "ProjectState": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProjectStatus",
          "default": "draft"
        },
        "current_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Item Id"
        },
        "completed_items": {
          "items": {
            "type": "string"
          },
          "title": "Completed Items",
          "type": "array"
        },
        "failed_items": {
          "items": {
            "type": "string"
          },
          "title": "Failed Items",
          "type": "array"
        },
        "attempts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Attempts",
          "type": "object"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectState",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "draft",
        "planned",
        "running",
        "waiting_review",
        "completed",
        "completed_with_gaps",
        "needs_input",
        "failed",
        "cancelled"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "ResearchGoal": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "question": {
          "minLength": 3,
          "title": "Question",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "deliverables": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Deliverables",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "question",
        "success_criteria",
        "deliverables"
      ],
      "title": "ResearchGoal",
      "type": "object"
    },
    "ResearchPlan": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/WorkItemSpec"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "planner_backend": {
          "title": "Planner Backend",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "items",
        "planner_backend",
        "rationale"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "ResearchProjectSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "domain": {
          "default": "disease_target_discovery",
          "enum": [
            "disease_target_discovery",
            "life_science"
          ],
          "title": "Domain",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/ResearchGoal"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "autonomy_mode": {
          "$ref": "#/$defs/AutonomyMode",
          "default": "checkpointed"
        },
        "max_work_items": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Work Items",
          "type": "integer"
        },
        "max_replans": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "title",
        "goal"
      ],
      "title": "ResearchProjectSpec",
      "type": "object"
    },
    "WorkItemResult": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "module",
        "status",
        "summary"
      ],
      "title": "WorkItemResult",
      "type": "object"
    },
    "WorkItemSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "title": {
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "module": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Module",
          "type": "string"
        },
        "objective": {
          "minLength": 3,
          "title": "Objective",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "input_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "review_level": {
          "$ref": "#/$defs/AssessmentLevel",
          "default": "A0"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "title",
        "module",
        "objective",
        "acceptance_criteria"
      ],
      "title": "WorkItemSpec",
      "type": "object"
    },
    "WorkItemStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "completed_with_gaps",
        "needs_input",
        "blocked",
        "failed",
        "skipped"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/ResearchProjectSpec"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work_item_results": {
      "items": {
        "$ref": "#/$defs/WorkItemResult"
      },
      "title": "Work Item Results",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/AssessmentRecord"
      },
      "title": "Assessments",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/DecisionEvent"
      },
      "title": "Decisions",
      "type": "array"
    },
    "event_cursor": {
      "default": 0,
      "minimum": 0,
      "title": "Event Cursor",
      "type": "integer"
    },
    "domain_activity_cursor": {
      "default": 0,
      "minimum": 0,
      "title": "Domain Activity Cursor",
      "type": "integer"
    },
    "domain_stage_summary": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Domain Stage Summary",
      "type": "array"
    },
    "next_actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Next Actions",
      "type": "array"
    }
  },
  "required": [
    "spec"
  ],
  "title": "ResearchProjectSnapshot",
  "type": "object"
}
