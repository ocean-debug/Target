  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.1.0",
      "default": "2.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "accession": {
      "title": "Accession",
      "type": "string"
    },
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
