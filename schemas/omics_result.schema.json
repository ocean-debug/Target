          "title": "Contract Version",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "required": [
        "name",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "covered",
        "partial",
        "not_covered",
        "unknown"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "ToolStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "out_of_scope"
