# Step OpenAI-compatible API. Keep model deployment configurable.
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
STEP_MODEL=step-3.7-flash
STEP_CONNECT_TIMEOUT_SECONDS=10
STEP_READ_TIMEOUT_SECONDS=90
STEP_MAX_RETRIES=3

# Optional NCBI identity/rate-limit key.
NCBI_API_KEY=

# All generated artifacts stay outside Git.
TARGET_AGENT_RUN_DIR=runs
TARGET_AGENT_CACHE_DIR=cache
TARGET_AGENT_TOOL_REGISTRY=configs/tool_registry.yaml
TARGET_AGENT_ENABLE_LIMMA=false
TARGET_AGENT_ENABLE_CENSUS_EXPRESSION=false
TARGET_AGENT_WEB_WORKERS=2
TARGET_AGENT_WEB_QUEUE_SIZE=8
TARGET_AGENT_GSEA_PERMUTATIONS=1000
TARGET_AGENT_RANDOM_SEED=123
